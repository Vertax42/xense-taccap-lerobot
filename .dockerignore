# Misc
.git
.github
.agents
.codex
tmp
wandb
data
outputs
.vscode
rl
media

# Logging / local credentials
logs
*.log
nautilus/*.yaml
*.key
sbatch*.sh

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# C extensions. Native libraries committed in vendor submodules are required
# by the hardware SDK build and are explicitly included again below.
*.so
!third_party/**/*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Test / coverage / tooling output
!tests/artifacts
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/

# Ignore runtime cache except checked-in calibration data
.cache/*
!.cache/calibration/
!.cache/calibration/**

# IDEs, notebooks and generated documentation
.venv/
.ipynb_checkpoints
profile_default/
ipython_config.py
.spyderproject
.spyproject
.ropeproject
docs/_build/
/site
target/

# Application output that should not inflate the build context
*.safetensors
*.mp4
*.avi

# Hardware SDK sources and their vendor-provided native libraries under
# third_party/ must remain in the context. Keep this override last.
!third_party/**
